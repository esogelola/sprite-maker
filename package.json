{
  "name": "sprite-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop app that turns a natural-language prompt into pixel art with a local Qwen 3 generator and a bounded Qwen 3 VL critique loop.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run tests/live --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
